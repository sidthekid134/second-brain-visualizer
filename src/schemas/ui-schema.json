{
    "story": {
        "title": "Story",
        "description": "Individual work items within the project",
        "sections": [
            {
                "id": "basic",
                "title": "Basic Information",
                "fields": [
                    {
                        "key": "id",
                        "label": "Story ID",
                        "type": "text",
                        "readonly": true,
                        "description": "Unique identifier for the story"
                    },
                    {
                        "key": "objective",
                        "label": "Objective",
                        "type": "textarea",
                        "required": true,
                        "placeholder": "What needs to be accomplished?",
                        "description": "The main goal or purpose of this story"
                    },
                    {
                        "key": "intent_id",
                        "label": "Intent",
                        "type": "intent_select",
                        "required": true,
                        "description": "Which intent this story contributes to"
                    },
                    {
                        "key": "workstream_id",
                        "label": "Workstream",
                        "type": "text",
                        "required": true,
                        "placeholder": "e.g., workstream-auth-backend",
                        "description": "The workstream this story belongs to"
                    }
                ]
            },
            {
                "id": "assignment",
                "title": "Assignment & Planning",
                "fields": [
                    {
                        "key": "complexity_score",
                        "label": "Complexity Score",
                        "type": "number",
                        "min": 1,
                        "max": 10,
                        "default": 1,
                        "description": "Difficulty rating from 1 (simple) to 10 (very complex)"
                    },
                    {
                        "key": "estimated_tokens",
                        "label": "Estimated Tokens",
                        "type": "number",
                        "min": 0,
                        "description": "Expected token usage for completion"
                    }
                ]
            },
            {
                "id": "criteria",
                "title": "Acceptance Criteria",
                "fields": [
                    {
                        "key": "acceptance_criteria",
                        "label": "Acceptance Criteria",
                        "type": "array",
                        "itemType": "text",
                        "required": true,
                        "description": "List of conditions that must be met for completion",
                        "placeholder": "Add acceptance criterion..."
                    }
                ]
            },
            {
                "id": "dependencies",
                "title": "Dependencies",
                "fields": [
                    {
                        "key": "dependencies",
                        "label": "Dependencies",
                        "type": "dependency_multiselect",
                        "description": "Intents, checkpoints, or stories that must be completed before this one can start"
                    }
                ]
            },
            {
                "id": "preferences",
                "title": "Preferences",
                "fields": [
                    {
                        "key": "preferences.preferred_agents",
                        "label": "Preferred Agents",
                        "type": "agent_multiselect",
                        "description": "Ranked list of preferred agents for this story"
                    },
                    {
                        "key": "preferences.execution_overrides.max_runtime_seconds",
                        "label": "Max Runtime (seconds)",
                        "type": "number",
                        "min": 0,
                        "description": "Maximum execution time in seconds"
                    },
                    {
                        "key": "preferences.execution_overrides.require_manual_approval",
                        "label": "Require Manual Approval",
                        "type": "boolean",
                        "description": "Whether this story requires manual approval before execution"
                    }
                ]
            },
            {
                "id": "execution",
                "title": "Execution Details",
                "fields": [
                    {
                        "key": "execution.current.status",
                        "label": "Status",
                        "type": "select",
                        "readonly": true,
                        "options": [
                            {
                                "value": "planned",
                                "label": "📋 Planned",
                                "color": "#6b7280"
                            },
                            {
                                "value": "in_progress",
                                "label": "🔄 In Progress",
                                "color": "#f59e0b"
                            },
                            {
                                "value": "done",
                                "label": "✅ Done",
                                "color": "#10b981"
                            },
                            {
                                "value": "failed",
                                "label": "❌ Failed",
                                "color": "#ef4444"
                            }
                        ],
                        "description": "Current execution status of the story"
                    },
                    {
                        "key": "execution.current.agent_id",
                        "label": "Assigned Agent",
                        "type": "agent_select",
                        "readonly": true,
                        "description": "The agent currently assigned to this story"
                    },
                    {
                        "key": "execution.current.started_at",
                        "label": "Started At",
                        "type": "datetime",
                        "readonly": true,
                        "description": "When execution started"
                    },
                    {
                        "key": "execution.current.ended_at",
                        "label": "Ended At",
                        "type": "datetime",
                        "readonly": true,
                        "description": "When execution completed"
                    },
                    {
                        "key": "execution.current.duration_seconds",
                        "label": "Duration (seconds)",
                        "type": "number",
                        "readonly": true,
                        "description": "Total execution time in seconds"
                    },
                    {
                        "key": "execution.current.branch",
                        "label": "Branch",
                        "type": "text",
                        "readonly": true,
                        "description": "Git branch used for execution"
                    },
                    {
                        "key": "execution.current.commit_sha",
                        "label": "Commit SHA",
                        "type": "text",
                        "readonly": true,
                        "description": "Git commit hash"
                    },
                    {
                        "key": "execution.current.pr_number",
                        "label": "PR Number",
                        "type": "number",
                        "readonly": true,
                        "description": "Pull request number"
                    },
                    {
                        "key": "execution.current.pr_url",
                        "label": "PR URL",
                        "type": "url",
                        "readonly": true,
                        "description": "Pull request URL"
                    },
                    {
                        "key": "execution.current.result",
                        "label": "Result",
                        "type": "textarea",
                        "readonly": true,
                        "description": "Execution result or error message"
                    },
                    {
                        "key": "execution.current.messages_count",
                        "label": "Messages Count",
                        "type": "number",
                        "readonly": true,
                        "description": "Number of messages exchanged during execution"
                    }
                ]
            },
            {
                "id": "notes",
                "title": "Implementation",
                "fields": [
                    {
                        "key": "implementation_notes",
                        "label": "Implementation Notes",
                        "type": "array",
                        "itemType": "text",
                        "description": "Technical notes and implementation details",
                        "placeholder": "Add implementation note..."
                    }
                ]
            }
        ]
    },
    "checkpoint": {
        "title": "Checkpoint",
        "description": "Major project phases or deliverables",
        "sections": [
            {
                "id": "basic",
                "title": "Basic Information",
                "fields": [
                    {
                        "key": "id",
                        "label": "Checkpoint ID",
                        "type": "text",
                        "readonly": true,
                        "description": "Unique identifier for the checkpoint"
                    },
                    {
                        "key": "name",
                        "label": "Name",
                        "type": "text",
                        "required": true,
                        "placeholder": "Checkpoint name",
                        "description": "Descriptive name for this checkpoint"
                    },
                    {
                        "key": "description",
                        "label": "Description",
                        "type": "textarea",
                        "required": true,
                        "placeholder": "Describe what this checkpoint represents",
                        "description": "Detailed description of the checkpoint"
                    }
                ]
            },
            {
                "id": "stories",
                "title": "Stories",
                "fields": [
                    {
                        "key": "story_ids",
                        "label": "Story IDs",
                        "type": "story_multiselect",
                        "required": true,
                        "description": "Stories that must be completed for this checkpoint"
                    }
                ]
            },
            {
                "id": "dependencies",
                "title": "Dependencies",
                "fields": [
                    {
                        "key": "dependencies",
                        "label": "Dependencies",
                        "type": "dependency_multiselect",
                        "description": "Intents, checkpoints, or stories that must be completed before this checkpoint"
                    }
                ]
            }
        ]
    },
    "intent": {
        "title": "Intent",
        "description": "High-level project goals and objectives",
        "sections": [
            {
                "id": "basic",
                "title": "Basic Information",
                "fields": [
                    {
                        "key": "id",
                        "label": "Intent ID",
                        "type": "text",
                        "readonly": true,
                        "description": "Unique identifier for the intent"
                    },
                    {
                        "key": "name",
                        "label": "Name",
                        "type": "text",
                        "required": true,
                        "placeholder": "Intent name",
                        "description": "Descriptive name for this intent"
                    },
                    {
                        "key": "description",
                        "label": "Description",
                        "type": "textarea",
                        "required": true,
                        "placeholder": "Describe the intent and its goals",
                        "description": "Detailed description of what this intent aims to achieve"
                    }
                ]
            },
            {
                "id": "dependencies",
                "title": "Dependencies",
                "fields": [
                    {
                        "key": "dependencies",
                        "label": "Dependencies",
                        "type": "dependency_multiselect",
                        "description": "Other intents, checkpoints, or stories that must be completed before this intent"
                    }
                ]
            }
        ]
    },
    "milestone": {
        "title": "Milestone",
        "description": "Major project phases or deliverables (legacy - use checkpoints instead)",
        "sections": [
            {
                "id": "basic",
                "title": "Basic Information",
                "fields": [
                    {
                        "key": "id",
                        "label": "Milestone ID",
                        "type": "text",
                        "readonly": true,
                        "description": "Unique identifier for the milestone"
                    },
                    {
                        "key": "name",
                        "label": "Name",
                        "type": "text",
                        "required": true,
                        "placeholder": "Milestone name",
                        "description": "Descriptive name for this milestone"
                    },
                    {
                        "key": "status",
                        "label": "Status",
                        "type": "select",
                        "required": true,
                        "options": [
                            {
                                "value": "planned",
                                "label": "📋 Planned",
                                "color": "#6b7280"
                            },
                            {
                                "value": "in_progress",
                                "label": "🔄 In Progress",
                                "color": "#f59e0b"
                            },
                            {
                                "value": "completed",
                                "label": "✅ Completed",
                                "color": "#10b981"
                            },
                            {
                                "value": "on_hold",
                                "label": "⏸️ On Hold",
                                "color": "#f59e0b"
                            }
                        ],
                        "description": "Current status of the milestone"
                    },
                    {
                        "key": "manager_id",
                        "label": "Manager",
                        "type": "agent_select",
                        "description": "The manager responsible for this milestone"
                    }
                ]
            }
        ]
    },
    "project": {
        "title": "Project",
        "description": "Overall project information and settings",
        "sections": [
            {
                "id": "basic",
                "title": "Project Details",
                "fields": [
                    {
                        "key": "id",
                        "label": "Project ID",
                        "type": "text",
                        "readonly": true
                    },
                    {
                        "key": "name",
                        "label": "Project Name",
                        "type": "text",
                        "required": true,
                        "placeholder": "Enter project name"
                    },
                    {
                        "key": "description",
                        "label": "Description",
                        "type": "textarea",
                        "placeholder": "Describe the project goals and scope"
                    },
                    {
                        "key": "status",
                        "label": "Status",
                        "type": "select",
                        "options": [
                            {
                                "value": "planned",
                                "label": "📋 Planned"
                            },
                            {
                                "value": "executing",
                                "label": "🔄 Executing"
                            },
                            {
                                "value": "completed",
                                "label": "✅ Completed"
                            },
                            {
                                "value": "on_hold",
                                "label": "⏸️ On Hold"
                            },
                            {
                                "value": "cancelled",
                                "label": "❌ Cancelled"
                            }
                        ]
                    }
                ]
            },
            {
                "id": "progress",
                "title": "Progress & Budget",
                "fields": [
                    {
                        "key": "progress.completion_percentage",
                        "label": "Completion %",
                        "type": "number",
                        "min": 0,
                        "max": 100,
                        "readonly": true,
                        "description": "Auto-calculated based on completed stories"
                    },
                    {
                        "key": "budget.limit",
                        "label": "Budget Limit",
                        "type": "number",
                        "min": 0,
                        "description": "Maximum budget for the project"
                    },
                    {
                        "key": "budget.used",
                        "label": "Budget Used",
                        "type": "number",
                        "min": 0,
                        "readonly": true,
                        "description": "Amount of budget consumed so far"
                    }
                ]
            },
            {
                "id": "roadmap",
                "title": "Roadmap",
                "fields": [
                    {
                        "key": "roadmap.intents",
                        "label": "Intents",
                        "type": "intent_list",
                        "readonly": true,
                        "description": "High-level project intents and their dependencies"
                    }
                ]
            },
            {
                "id": "checkpoints",
                "title": "Checkpoints",
                "fields": [
                    {
                        "key": "checkpoints",
                        "label": "Checkpoints",
                        "type": "checkpoint_list",
                        "readonly": true,
                        "description": "Project checkpoints and milestones"
                    }
                ]
            }
        ]
    },
    "agent": {
        "title": "Agent",
        "description": "Team members and their roles",
        "sections": [
            {
                "id": "basic",
                "title": "Agent Information",
                "fields": [
                    {
                        "key": "id",
                        "label": "Agent ID",
                        "type": "text",
                        "readonly": true
                    },
                    {
                        "key": "name",
                        "label": "Name",
                        "type": "text",
                        "required": true,
                        "placeholder": "Agent name"
                    },
                    {
                        "key": "role",
                        "label": "Role",
                        "type": "select",
                        "options": [
                            {
                                "value": "conductor",
                                "label": "🎼 Conductor"
                            },
                            {
                                "value": "manager",
                                "label": "👨‍💼 Manager"
                            },
                            {
                                "value": "engineer",
                                "label": "👨‍💻 Engineer"
                            }
                        ]
                    },
                    {
                        "key": "manager_id",
                        "label": "Manager",
                        "type": "agent_select",
                        "description": "The manager this agent reports to"
                    }
                ]
            },
            {
                "id": "hierarchy",
                "title": "Hierarchy",
                "fields": [
                    {
                        "key": "reports",
                        "label": "Reports",
                        "type": "agent_multiselect",
                        "description": "Agents that report to this agent"
                    },
                    {
                        "key": "assigned_story_ids",
                        "label": "Assigned Stories",
                        "type": "story_multiselect",
                        "readonly": true,
                        "description": "Stories currently assigned to this agent"
                    }
                ]
            }
        ]
    },
    "ui_config": {
        "colors": {
            "status": {
                "in_progress": "#f59e0b",
                "done": "#10b981",
                "planned": "#6b7280",
                "failed": "#ef4444",
                "cancelled": "#ef4444"
            },
            "complexity": {
                "1-2": "#10b981",
                "3-4": "#f59e0b",
                "5-6": "#ef4444",
                "7-8": "#dc2626",
                "9-10": "#7c2d12"
            },
            "dependency_types": {
                "intent": "#8b5cf6",
                "checkpoint": "#06b6d4",
                "workstream": "#10b981",
                "story": "#f59e0b"
            }
        },
        "icons": {
            "planned": "📋",
            "in_progress": "🔄",
            "done": "✅",
            "failed": "❌",
            "cancelled": "❌",
            "intent": "🎯",
            "checkpoint": "🏁",
            "workstream": "🔧",
            "story": "📝",
            "agent": "👤",
            "dependency": "🔗"
        }
    }
}