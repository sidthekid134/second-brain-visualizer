{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Project Execution & Roadmap Schema with Dependencies",
    "type": "object",
    "properties": {
        "project": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "planned",
                        "executing",
                        "completed",
                        "on_hold",
                        "cancelled"
                    ]
                },
                "created_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "updated_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "progress": {
                    "type": "object",
                    "properties": {
                        "completion_percentage": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                        }
                    },
                    "required": [
                        "completion_percentage"
                    ]
                },
                "budget": {
                    "type": "object",
                    "properties": {
                        "limit": {
                            "type": "number",
                            "minimum": 0
                        },
                        "used": {
                            "type": "number",
                            "minimum": 0
                        }
                    },
                    "required": [
                        "limit",
                        "used"
                    ]
                },
                "roadmap": {
                    "type": "object",
                    "properties": {
                        "intents": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/intent"
                            },
                            "minItems": 1
                        }
                    },
                    "required": [
                        "intents"
                    ]
                },
                "checkpoints": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/checkpoint"
                    }
                }
            },
            "required": [
                "id",
                "name",
                "status",
                "created_at",
                "updated_at",
                "progress",
                "budget",
                "roadmap",
                "checkpoints"
            ],
            "additionalProperties": false
        },
        "stories": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/story"
            }
        },
        "agents": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/agent"
            }
        }
    },
    "required": [
        "project",
        "stories",
        "agents"
    ],
    "additionalProperties": false,
    "definitions": {
        "dependency": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "intent",
                        "workstream",
                        "checkpoint",
                        "story"
                    ]
                },
                "id": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "id"
            ],
            "additionalProperties": false
        },
        "intent": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "dependencies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dependency"
                    }
                }
            },
            "required": [
                "id",
                "name",
                "description"
            ],
            "additionalProperties": false
        },
        "checkpoint": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "story_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "dependencies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dependency"
                    }
                }
            },
            "required": [
                "id",
                "name",
                "description",
                "story_ids"
            ],
            "additionalProperties": false
        },
        "story": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "objective": {
                    "type": "string"
                },
                "intent_id": {
                    "type": "string"
                },
                "workstream_id": {
                    "type": "string"
                },
                "acceptance_criteria": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                },
                "dependencies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dependency"
                    }
                },
                "implementation_notes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "estimated_tokens": {
                    "type": "number",
                    "minimum": 0
                },
                "complexity_score": {
                    "type": "number",
                    "minimum": 0
                },
                "created_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "updated_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "preferences": {
                    "type": "object",
                    "properties": {
                        "preferred_agents": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "execution_overrides": {
                            "type": "object",
                            "properties": {
                                "max_runtime_seconds": {
                                    "type": "number",
                                    "minimum": 0
                                },
                                "require_manual_approval": {
                                    "type": "boolean"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                },
                "execution": {
                    "$ref": "#/definitions/execution_detail"
                }
            },
            "required": [
                "id",
                "objective",
                "intent_id",
                "workstream_id",
                "acceptance_criteria",
                "dependencies",
                "implementation_notes",
                "estimated_tokens",
                "complexity_score",
                "created_at",
                "updated_at",
                "execution"
            ],
            "additionalProperties": false
        },
        "execution_detail": {
            "type": "object",
            "properties": {
                "current": {
                    "$ref": "#/definitions/execution_run"
                },
                "history": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/execution_run"
                    }
                }
            },
            "required": [
                "current",
                "history"
            ],
            "additionalProperties": false
        },
        "execution_run": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "planned",
                        "in_progress",
                        "done",
                        "failed"
                    ]
                },
                "started_at": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time"
                },
                "ended_at": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time"
                },
                "duration_seconds": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0
                },
                "agent_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "branch": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "commit_sha": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "pr_number": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "pr_url": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "uri"
                },
                "result": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "messages_count": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0
                }
            },
            "required": [
                "status"
            ],
            "additionalProperties": false
        },
        "agent": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "role": {
                    "type": "string",
                    "enum": [
                        "conductor",
                        "manager",
                        "engineer"
                    ]
                },
                "manager_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "reports": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "assigned_story_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "id",
                "name",
                "role",
                "reports"
            ],
            "additionalProperties": false
        }
    }
}